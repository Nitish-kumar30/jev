# Copy this file to server/.env and paste your key in.
# server/.env is git-ignored and is never read by the browser.

# Shared password for the deployed site (Vercel project settings, Production
# and Preview). middleware.js reads SITE_PASSWORD. If it is missing, the
# deployment stays locked. It does not gate `npm run dev`.
SITE_PASSWORD=

# One OpenRouter key covers both sides.
OPENROUTER_API_KEY=

# Jev uses the Decisions API, not chat completions.
# Pin a version, or set ~typesafe/jev-latest to follow the newest release.
JEV_MODEL=typesafe/jev-1.13

# Any OpenRouter chat model. This is the chatbot side of the comparison.
LLM_MODEL=openai/gpt-4o-mini

# Model Router tab: the two models Jev routes between. Any OpenRouter chat models.
# Only called when "Answer each request" is switched on in the tab.
ROUTER_FAST_MODEL=openai/gpt-4o-mini
ROUTER_POWERFUL_MODEL=openai/gpt-4o

PORT=8787
