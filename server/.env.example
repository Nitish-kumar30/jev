# Copy this file to server/.env and paste your keys in.
# server/.env is git-ignored and is never read by the browser.

# --- Jev (TypeSafe AI) ---
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_CLASSIFY_MODEL=ticket-router-v1
JEV_GATE_MODEL=action-gate-v1

# --- Chatbot LLM (defaults to the Anthropic Messages API) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com/v1/messages
LLM_MODEL=claude-haiku-4-5-20251001

PORT=8787
